# Moving tag that follows main, published once both architectures finish building, so it always
# names a complete set of images. Pin a release (0.1.0) or a full commit SHA for a fixed
# deployment; `docker compose pull` is what moves a moving tag.
IMAGE_TAG=edge
# Use URL-safe characters in the PostgreSQL password.
POSTGRES_PASSWORD=replace-with-a-long-random-password
JEV_API_KEY=replace-with-your-jev-api-key

# Optional settings.
WITHHUMAN_MODE=shadow
# Per-user keys: the token of the administration API (/v1/admin) that issues and revokes them,
# and whether Hooks without a valid key are refused (on) or taken without a user (off).
# WITHHUMAN_ADMIN_TOKEN=replace-with-a-long-random-token
# WITHHUMAN_REQUIRE_KEY=off
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=3000

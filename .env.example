# Moving tag that follows main, published once both architectures finish building, so it always
# names a complete set of images. Pin a release (0.1.0) or a full commit SHA for a fixed
# deployment; `docker compose pull` is what moves a moving tag.
IMAGE_TAG=edge
# Use URL-safe characters in the PostgreSQL password.
POSTGRES_PASSWORD=replace-with-a-long-random-password
JEV_API_KEY=replace-with-your-jev-api-key

# Optional settings.
WITHHUMAN_MODE=shadow
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=3000

# Graph viewer (`--profile graph-viewer`). The password of its withhuman_viewer role; URL-safe.
VIEWER_DB_PASSWORD=replace-with-another-long-random-password
# VIEWER_PORT=7480
# INFUSE_ATTACKS_DIR=/home/ubuntu/infuse/benchmark/attacks

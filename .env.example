# Moving tag that follows main, published once both architectures finish building, so it always
# names a complete set of images. Pin a release (0.1.0) or a full commit SHA for a fixed
# deployment; `docker compose pull` is what moves a moving tag.
IMAGE_TAG=edge
NEO4J_PASSWORD=replace-with-a-long-random-password
JEV_API_KEY=replace-with-your-jev-api-key

# Optional settings.
WITHHUMAN_MODE=shadow
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=3000

[Unit]
Description=Check withhuman-core for a new build

[Timer]
# The instance overrides this from Terraform in
# /etc/systemd/system/withhuman-update.timer.d/schedule.conf.
OnCalendar=daily
# Spreads the pull so a fleet does not hit the registry at the same second.
RandomizedDelaySec=30m
# Catches up after the host was off past a run.
Persistent=true

[Install]
WantedBy=timers.target

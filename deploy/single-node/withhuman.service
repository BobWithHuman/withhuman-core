[Unit]
Description=withhuman engine
Documentation=https://github.com/BobWithHuman/withhuman-core
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Neo4j's first boot builds the store and the schema Job waits for it, so the first run is slow.
TimeoutStartSec=900
ExecStart=/usr/local/bin/withhuman-apply
ExecStop=/usr/local/bin/withhuman-apply down

[Install]
WantedBy=multi-user.target

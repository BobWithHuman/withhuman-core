[Unit]
Description=Move the withhuman engine to the configured source ref
Documentation=https://github.com/BobWithHuman/withhuman-core
Requires=docker.service
After=docker.service network-online.target
# Never races the boot unit, which runs the same script.
After=withhuman.service

[Service]
Type=oneshot
TimeoutStartSec=900
ExecStart=/usr/local/bin/withhuman-apply

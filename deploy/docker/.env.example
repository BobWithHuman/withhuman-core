# Copy this file to deploy/docker/.env and replace the development password.
NEO4J_PASSWORD=replace-with-a-local-password

# Optional host port overrides.
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Optional memory overrides.
NEO4J_HEAP_INITIAL_SIZE=512m
NEO4J_HEAP_MAX_SIZE=512m
NEO4J_PAGECACHE_SIZE=512m

              "WITHHUMAN_KEY"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/withhuman/hooks/pre-tool-use.py\" https://withhuman.example.com/v1/hooks/PreToolUse"
          }
        ]
      }
    ],

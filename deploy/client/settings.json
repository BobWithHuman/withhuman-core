{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://withhuman.example.com/v1/hooks/SessionStart",
            "headers": {
              "x-withhuman-client": "$WITHHUMAN_CLIENT_ID",
              "Authorization": "Bearer $WITHHUMAN_KEY"
            },
            "allowedEnvVars": [
              "WITHHUMAN_CLIENT_ID",
              "WITHHUMAN_KEY"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://withhuman.example.com/v1/hooks/UserPromptSubmit",

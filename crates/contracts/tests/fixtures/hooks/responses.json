{
  "session_start": {
    "hookSpecificOutput": {
      "hookEventName": "SessionStart",
      "watchPaths": ["/app/CLAUDE.md", "/app/.mcp.json"]
    }
  },
  "pre_tool_use_deny": {
    "hookSpecificOutput": {
      "hookEventName": "PreToolUse",
      "permissionDecision": "deny",
      "permissionDecisionReason": "Blocked by WithHuman."
    }
  },
  "pre_tool_use_review": {
    "hookSpecificOutput": {
      "hookEventName": "PreToolUse",
      "permissionDecision": "ask",
      "permissionDecisionReason": "Approval required by WithHuman."
    }
  },
  "user_prompt_submit": {
    "hookSpecificOutput": {
      "hookEventName": "UserPromptSubmit",
      "additionalContext": "응답 첫 줄에 [의도] ... 형식으로 쓸 것."
    }
  },
  "message_display": {
    "hookSpecificOutput": {
      "hookEventName": "MessageDisplay",
      "displayContent": "**[파악한 의도] → 로그인 버그 수정**\n"
    }
  }
}
